#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] Checking Dart formatting..."
format_log="$(mktemp)"
trap 'rm -f "$format_log"' EXIT HUP INT TERM
if ! dart format --output=none --set-exit-if-changed . >"$format_log" 2>&1; then
  cat "$format_log"
  echo "[pre-commit] Run dart format, then stage the intended changes and retry."
  exit 1
fi
cat "$format_log"

echo "[pre-commit] Running Flutter analyzer..."
flutter analyze --fatal-infos --fatal-warnings

echo "[pre-commit] Running Flutter tests..."
flutter test

echo "[pre-commit] Checks passed."
